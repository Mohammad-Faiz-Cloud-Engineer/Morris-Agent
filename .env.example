# =============================================================
#  Morris Agent — API Keys
# =============================================================
#  Copy this file to .env and fill in your keys.
#
#    cp .env.example .env
#
#  All keys are OPTIONAL. Morris Agent works without them, but you
#  lose the corresponding feature (see table below).
#
#  ┌────────────────────────┬────────────────────────────────┐
#  │ Variable               │ Feature unlocked               │
#  ├────────────────────────┼────────────────────────────────┤
#  │ OPENWEATHER_API_KEY    │ Live weather lookups           │
#  │ NEWSAPI_KEY            │ Top news headlines             │
#  │ CLOUD_API_KEY          │ Cloud AI answers               │
#  │ CLOUD_MODEL            │ Cloud model name               │
#  │ CLOUD_BASE_URL         │ OpenAI-compatible API base URL │
#  └────────────────────────┴────────────────────────────────┘
# =============================================================

OPENWEATHER_API_KEY=
NEWSAPI_KEY=

# -------------------------------------------------------------
#  Cloud AI (any OpenAI-compatible provider)
# -------------------------------------------------------------
# Works with OpenAI, Groq, Together, DeepSeek, Moonshot, OpenRouter,
# or a local server exposing an OpenAI-style /chat/completions endpoint
# (vLLM, Ollama's OpenAI compatibility, etc.).
#
#   Example (OpenAI):      CLOUD_BASE_URL=https://api.openai.com/v1
#                          CLOUD_MODEL=gpt-4o-mini
#   Example (Groq):        CLOUD_BASE_URL=https://api.groq.com/openai/v1
#                          CLOUD_MODEL=llama-3.3-70b-versatile
#   Example (Moonshot):    CLOUD_BASE_URL=https://api.moonshot.ai/v1
#                          CLOUD_MODEL=kimi-k2-0905-preview
#
# CLOUD_API_KEY / CLOUD_MODEL / CLOUD_BASE_URL are all required. If the
# base URL is omitted it defaults to https://api.openai.com/v1.
CLOUD_API_KEY=
CLOUD_MODEL=
CLOUD_BASE_URL=
# Optional: free token from huggingface.co/settings/tokens. Speeds up
# faster-whisper model downloads and avoids the unauthenticated-rate-limit
# warning. Not needed once models are cached.
HF_TOKEN=
